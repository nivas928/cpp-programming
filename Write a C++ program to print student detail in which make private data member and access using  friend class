#include<iostream>
 #include<string>
using namespace std;
class Student
{
 private:
 string name;
int roll;
 public:
 void setData(string name,int roll)
 {
 this->name = name;
 this->roll = roll;
 }
 friend class Bca;
};
class Bca
{
 public:
 void show(Student obj)
 {
 cout<<"Name : "<<obj.name<<endl;
 cout<<"Roll No. : "<<obj.roll<<endl;
 }
};
int main( )
{
 Student s1;
 s1.setData("Lav",10);
 Bca b1;
 b1.show(s1);
 return 0;
 }
